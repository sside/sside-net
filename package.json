{
    "name": "sside-net",
    "scripts": {
        "build": "turbo run build:shared && turbo run build:app",
        "build:app": "turbo run build:app",
        "build:shared": "turbo run build:shared",
        "dev": "npm run build:shared && turbo run dev",
        "dev:app": "turbo run dev:app",
        "dev:shared": "npm run build:shared && turbo run dev:shared",
        "test": "turbo run test",
        "lint": "turbo run lint",
        "count-line": "cloc",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,yml,yaml,json}\"",
        "update:check": "ncu && turbo run update:check",
        "update:execute": "ncu -u && turbo run update:execute && npm install",
        "template": "plop",
        "reinstall": "node ./deleteNodeModules.js && npm install",
        "prepare": "husky"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@inquirer/search": "4.3.5",
        "@trivago/prettier-plugin-sort-imports": "6.0.2",
        "husky": "9.1.7",
        "inquirer-autocomplete-prompt": "3.0.1",
        "lint-staged": "17.6.0",
        "npm-check-updates": "23.1.1",
        "plop": "4.0.5",
        "prettier": "3.9.10",
        "prettier-plugin-tailwindcss": "0.8.1",
        "turbo": "2.11.10"
    },
    "engines": {
        "node": ">=26"
    },
    "packageManager": "npm@12.2.1",
    "workspaces": [
        "app/*",
        "config/*",
        "library/*",
        "resource/*",
        "generated/*"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/sside/sside-net.git"
    },
    "private": true,
    "allowScripts": {
        "@prisma/engines@7.9.1": true,
        "@scarf/scarf@1.4.0": true,
        "@sentry/cli@2.58.6": true,
        "@sentry/node-cpu-profiler@2.4.3": true,
        "@swc/core@1.16.0": true,
        "better-sqlite3@12.11.1": true,
        "msw@2.15.0": true,
        "prisma@7.9.1": true,
        "unrs-resolver@1.12.2": true
    }
}
