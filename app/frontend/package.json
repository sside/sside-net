{
    "name": "@sside-net/frontend",
    "version": "0.0.0",
    "private": true,
    "description": "sside.net frontend",
    "scripts": {
        "start": "next start",
        "dev": "rimraf .next && dotenvx run --env-file ../../.env -- cross-env PORT=42979 next dev --turbopack",
        "dev:app": "npm run dev",
        "dev:test": "dotenvx run --env-file ../../.env.test -- cross-env PORT=42980 next dev --turbopack",
        "build": "next build",
        "test:cli": "playwright test",
        "test:ui": "playwright test --ui",
        "test:ts": "tsc --noEmit",
        "lint": "eslint --fix",
        "update:check": "ncu",
        "update:execute": "ncu -u"
    },
    "dependencies": {
        "@milkdown/crepe": "7.22.1",
        "@milkdown/kit": "7.22.1",
        "@milkdown/react": "7.22.1",
        "@msw/playwright": "0.6.7",
        "@sentry/nextjs": "10.70.0",
        "@sside-net/constant": "*",
        "@sside-net/date-time": "*",
        "@sside-net/utility": "*",
        "@sside-net/validator": "*",
        "@tanstack/react-query": "5.101.4",
        "@tanstack/react-table": "9.1.2",
        "@yaireo/tagify": "4.38.0",
        "cross-env": "10.1.0",
        "dedent": "1.7.2",
        "http-status-codes": "2.3.0",
        "install": "0.13.0",
        "jwt-decode": "^4.0.0",
        "luxon": "3.7.2",
        "next": "16.3.1",
        "openapi-fetch": "0.17.0",
        "openapi-react-query": "0.5.4",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-hook-form": "7.85.0",
        "react-icons": "5.7.0",
        "react-markdown": "10.1.0",
        "rehype-raw": "7.0.0",
        "remark-gfm": "4.0.1",
        "tailwind-merge": "3.6.0",
        "tailwind-variants": "3.3.1",
        "utility-types": "3.11.0"
    },
    "devDependencies": {
        "@dotenvx/dotenvx": "2.21.0",
        "@faker-js/faker": "9.9.0",
        "@next/eslint-plugin-next": "16.3.1",
        "@playwright/test": "1.62.1",
        "@sside-net/eslint": "*",
        "@sside-net/open-api": "*",
        "@tailwindcss/postcss": "4.3.3",
        "@types/luxon": "3.7.4",
        "@types/node": "24",
        "@types/react": "19",
        "@types/react-dom": "19",
        "@types/yaireo__tagify": "4.27.0",
        "msw": "2.15.0",
        "postcss": "8.5.26",
        "rimraf": "6.1.3",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3"
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    }
}
